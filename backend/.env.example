# RoadSense AI Backend Environment Variables (Supabase PostgreSQL)

PORT=5000
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roadsense_db?schema=public"
JWT_SECRET="roadsense_ai_super_secret_jwt_key_2026"
NODE_ENV="development"

# AI Provider Configuration (Optional)
AI_PROVIDER_API_KEY=""
AI_PROVIDER_URL=""

# Upload & Cloud Storage Configuration (Supabase Storage)
MAX_FILE_SIZE_MB=5
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=roadsense-uploads
